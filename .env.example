# Interview Coach — environment template.
#
# This file is committed with EMPTY values on purpose. It documents every setting.
# The real .env lives ONLY on the server (never in git, never in the local checkout):
#
#     deploy/init-env.sh            # on the server: creates .env (chmod 600) and fills the
#                                   # two generated secrets; you paste the rest yourself
#
# Values are read by app/settings.py (names are case-insensitive) and config/models.yaml.

# ---------------------------------------------------------------- required: model providers
# Anthropic API key (console.anthropic.com). Used for plan, briefing, feedback, escalations.
ANTHROPIC_API_KEY=
# TypeSafe API key (console.typesafe.ai). Used for all Jev judgments.
TYPESAFE_API_KEY=
# Local model server (Ollama). On the server: the laptop's Tailscale address,
# e.g. http://100.x.y.z:11434 . For local development: http://localhost:11434
OLLAMA_BASE_URL=

# ---------------------------------------------------------------- required: app secrets
# Generated by deploy/init-env.sh. Keep a copy of PII_ENCRYPTION_KEY in a password manager:
# without it, stored runs can no longer show real names.
# Fernet key (32 url-safe base64 bytes) that encrypts the per-run name mapping.
PII_ENCRYPTION_KEY=
# Long random string that signs login cookies.
SESSION_SECRET=

# ---------------------------------------------------------------- optional
# Database location inside the container (default below).
DATABASE_URL=sqlite:///data/app.db
# Token for /healthz?deep=1 (checks Claude/Jev reachability without spending tokens).
HEALTH_TOKEN=
# Link to the source code shown on the public /demo page (empty = no link).
DEMO_REPO_URL=
# Only set to false for local http development; production runs behind https.
SECURE_COOKIES=true
# Days after which runs are deleted automatically (decision D8).
RETENTION_DAYS=30
# Practice runs a candidate may start per 24 hours.
RUNS_PER_USER_PER_DAY=5
# faster-whisper model size for spoken answers: small or medium (needs the "speech" deps).
WHISPER_MODEL=small
# Keep audio recordings after transcription (default: deleted right away).
KEEP_AUDIO=false

# ---------------------------------------------------------------- optional: oMLX instead of Ollama
# Only needed when a role in config/models.yaml uses provider: omlx
OMLX_BASE_URL=
OMLX_API_KEY=
