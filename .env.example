# Copy to .env (never commit .env). Real keys go only on the server and your laptop.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# The laptop's Ollama. On the server use the laptop's Tailscale IP, e.g. http://100.x.y.z:11434
OLLAMA_BASE_URL=http://localhost:11434
# Optional alternative local runtime (oMLX); only needed when a role uses provider: omlx
OMLX_BASE_URL=http://localhost:8000
OMLX_API_KEY=
DATABASE_URL=sqlite:///data/app.db
